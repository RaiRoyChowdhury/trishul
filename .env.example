# ============================================================================
# TRISHUL configuration. Copy this file to a new file named exactly  .env
# (same folder, no ".example") and fill in the values. NEVER share or upload .env.
# Lines starting with # are comments. No spaces around the = sign.
# ============================================================================

# ---- 1. SUPABASE (accounts + database)  REQUIRED, free tier is enough --------
# supabase.com -> New project -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-public-key
# SECRET: server only. Never paste this anywhere else. (API settings -> service_role)
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key

# The browser needs the first two values too (the anon key is public by design).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=paste-the-anon-public-key

# ---- 2. AI (Sarvam ONLY)  chat, speech-to-text, text-to-speech, voice cloning -
# dashboard.sarvam.ai -> API keys. One key does everything. No OpenAI or ElevenLabs anywhere.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_MODEL=bulbul:v3
SARVAM_DEFAULT_SPEAKER=shubh
# Paise charged against the shared Rs 20 budget when a cloned voice is created (0 disables cloning). Price is not published: 100 is an assumption.
SARVAM_CLONE_CREATE_PAISE=100
# The Rs 20 budget, the 30-day live window and activation are controlled ONLY by an admin inside the app (/admin).

# ---- 4. Emergency notifications   needed for real alerts to contacts ----------
# Option A (easiest, free): Telegram bot. Talk to @BotFather in Telegram -> /newbot -> copy the token.
# Each contact must open your bot and press Start once, then you put their chat id in Settings.
TELEGRAM_BOT_TOKEN=
# Option B: SMS via Twilio (console.twilio.com). Trial accounts can only text numbers you verified,
# and sending SMS to India normally needs sender registration (DLT). Check Twilio's current India rules.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- 5. Routing (safer-route comparison) -------------------------------------
# Default is the free public OpenStreetMap demo router: fine for a prototype, NOT for production.
ROUTING_BASE_URL=https://routing.openstreetmap.de/routed-foot
ROUTING_PROFILE=driving

# ---- 6. Server settings -------------------------------------------------------
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Only when frontend and backend are hosted on different websites (production):
# VITE_API_BASE_URL=https://your-backend.example.com

# --- Safe routes ---
# Danger zone = an area reported by at least this many DIFFERENT people in the last 90 days
DANGER_MIN_PEOPLE=4
# 10 invented sample reports for the demo (labelled "Sample" in the app). Set to off to hide them.
SAMPLE_REPORTS=on

# --- Profiles / Walk Together ---
# Photos are approved automatically in the prototype. Set to off to require admin approval (Admin page).
AUTO_APPROVE_PHOTOS=on
# on = people must be ID-verified before Walk Together. Leave off until a real verification provider exists.
REQUIRE_VERIFIED_WALK=off
# No provider is connected. Leave blank. (DigiLocker or another provider can be added later.)
VERIFICATION_PROVIDER=

# Shared judge account(s): comma separated login emails. These accounts are ALWAYS in Judge Demo Mode
# (every SOS is a test, no AI is used) and cannot switch it off. Public value, so it starts with VITE_.
VITE_JUDGE_EMAIL=
